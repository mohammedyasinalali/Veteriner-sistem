@model VetKlinik.Web.Models.Pets.VaccineFormModel
@{
    var pet = (VetKlinik.Web.Domain.Pet)ViewData["Pet"]!;
    ViewData["Title"] = $"{pet.Name} — Aşı Ekle";
}

<h1 class="h3 mb-3">@pet.Name — Aşı Ekle</h1>
<form asp-action="Create" asp-route-petId="@pet.Id" method="post" style="max-width: 36rem">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

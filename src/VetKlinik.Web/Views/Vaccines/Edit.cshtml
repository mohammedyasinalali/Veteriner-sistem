@model VetKlinik.Web.Models.Pets.VaccineFormModel
@{
    var record = (VetKlinik.Web.Domain.VaccineRecord)ViewData["Record"]!;
    ViewData["Title"] = $"{record.Pet.Name} — Aşı Düzenle";
}

<h1 class="h3 mb-3">@record.Pet.Name — Aşı Düzenle</h1>
<form asp-action="Edit" asp-route-id="@record.Id" method="post" style="max-width: 36rem">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-controller="Pets" asp-action="Details" asp-route-id="@record.PetId" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@using VetKlinik.Web.Services
@model VaccineSchedule
@{
    var me = (CurrentUser)ViewData["Me"]!;
}

<section id="asilar" class="mt-4" style="max-width: 56rem">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h5 mb-0">Aşılar</h2>
        <a asp-controller="Vaccines" asp-action="Create" asp-route-petId="@Model.Pet.Id" class="btn btn-sm btn-primary">Aşı ekle</a>
    </div>

    @if (Model.Upcoming.Count > 0)
    {
        <ul class="list-group mb-3">
            @foreach (var u in Model.Upcoming)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><strong>@u.VaccineName</strong> · @u.DueOn.ToString("dd.MM.yyyy")</span>
                    @if (u.IsOverdue)
                    {
                        <span class="badge text-bg-danger">@(-u.DaysLeft) gün gecikti</span>
                    }
                    else if (u.DaysLeft <= 30)
                    {
                        <span class="badge text-bg-warning">@(u.DaysLeft == 0 ? "Bugün" : $"{u.DaysLeft} gün kaldı")</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light border">@u.DaysLeft gün kaldı</span>
                    }
                </li>
            }
        </ul>
    }

    @if (Model.History.Count == 0)
    {
        <div class="alert alert-light border">Henüz aşı kaydı yok.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>Aşı</th><th>Uygulama</th><th>Sonraki doz</th><th>Giren</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var r in Model.History)
                {
                    <tr>
                        <td>@r.VaccineName</td>
                        <td>@r.AdministeredOn.ToString("dd.MM.yyyy")</td>
                        <td>@(r.NextDueOn?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td class="small text-muted">@(r.Veterinarian is null ? "Sahibi" : $"{r.Veterinarian.Title} {r.Veterinarian.User.FullName}")</td>
                        <td class="text-end text-nowrap">
                            @if (VaccineService.CanEdit(me, r))
                            {
                                <a asp-controller="Vaccines" asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-controller="Vaccines" asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@model VetKlinik.Web.Models.Pets.PetFormModel
@{ ViewData["Title"] = "Yeni Hayvan"; }

<h1 class="h3 mb-3">Yeni Hayvan</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" style="max-width: 48rem">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

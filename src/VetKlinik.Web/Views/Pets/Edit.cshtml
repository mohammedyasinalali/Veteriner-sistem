@model VetKlinik.Web.Models.Pets.PetFormModel
@{
    var pet = (VetKlinik.Web.Domain.Pet)ViewData["Pet"]!;
    ViewData["Title"] = $"{pet.Name} — Düzenle";
}

<h1 class="h3 mb-3">@pet.Name — Düzenle</h1>
<form asp-action="Edit" asp-route-id="@pet.Id" method="post" enctype="multipart/form-data" style="max-width: 48rem">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Details" asp-route-id="@pet.Id" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

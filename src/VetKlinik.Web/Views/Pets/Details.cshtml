@using VetKlinik.Web.Infrastructure
@model VetKlinik.Web.Services.VaccineSchedule
@{
    var pet = Model.Pet;
    ViewData["Title"] = pet.Name;
    var canEdit = ViewData["CanEdit"] is true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@pet.Name</h1>
    @if (canEdit)
    {
        <div>
            <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-outline-primary">Düzenle</a>
            <a asp-action="Delete" asp-route-id="@pet.Id" class="btn btn-outline-danger">Sil</a>
        </div>
    }
</div>
<div class="card shadow-sm" style="max-width: 40rem">
    <div class="card-body d-flex gap-4 flex-wrap">
        @if (pet.PhotoFileName is not null)
        {
            <img src="@Url.Action("Photo", new { id = pet.Id })" alt="@pet.Name" class="rounded border" style="width: 160px; height: 160px; object-fit: cover" />
        }
        <dl class="row mb-0 flex-grow-1">
            <dt class="col-5">Türü</dt><dd class="col-7">@SpeciesNames.Name(pet.Species)</dd>
            <dt class="col-5">Irkı</dt><dd class="col-7">@pet.Breed</dd>
            <dt class="col-5">Doğum tarihi</dt><dd class="col-7">@pet.BirthDate.ToString("dd.MM.yyyy")</dd>
            <dt class="col-5">Kilo</dt><dd class="col-7">@pet.WeightKg.ToString("0.##") kg</dd>
            <dt class="col-5">Sahibi</dt><dd class="col-7">@pet.Owner.FullName</dd>
        </dl>
    </div>
</div>
<partial name="_Vaccines" model="Model" />
<a asp-action="Index" class="btn btn-link mt-3 ps-0">← Listeye dön</a>

@model VetKlinik.Web.Domain.Pet
@{ ViewData["Title"] = "Hayvanı Sil"; }

<h1 class="h3 mb-3">Hayvanı Sil</h1>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="card shadow-sm" style="max-width: 32rem">
    <div class="card-body">
        <p><strong>@Model.Name</strong> kaydını silmek istediğinize emin misiniz?</p>
        <p class="text-muted small mb-3">Aşı kayıtları da silinir. Randevusu olan hayvan silinemez.</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Sil</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

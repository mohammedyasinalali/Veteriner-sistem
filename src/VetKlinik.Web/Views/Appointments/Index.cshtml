@using VetKlinik.Web.Infrastructure
@model List<VetKlinik.Web.Domain.Appointment>
@{
    var title = User.IsInRole(Roles.Admin) ? "Randevular" : "Randevularım";
    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@title</h1>
    @if (User.IsInRole(Roles.Uye))
    {
        <a asp-action="Book" class="btn btn-primary">Randevu al</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">Henüz randevu yok.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Tarih</th><th>Hayvan</th><th>Hizmet</th><th>Hekim</th><th class="text-end">Ücret</th><th>Durum</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="text-nowrap">@a.StartsAt.ToString("dd.MM.yyyy") <span class="text-muted">@a.StartsAt.ToString("HH:mm")–@a.EndsAt.ToString("HH:mm")</span></td>
                    <td><a asp-controller="Pets" asp-action="Details" asp-route-id="@a.PetId">@a.Pet.Name</a></td>
                    <td>@a.Service.Name</td>
                    <td>@a.Veterinarian.Title @a.Veterinarian.User.FullName</td>
                    <td class="text-end">@a.Price.ToString("N2") ₺</td>
                    <td>
                        <span class="badge @AppointmentStatusNames.Badge(a.Status)">@AppointmentStatusNames.Name(a.Status)</span>
                        @if (a.RejectionReason is not null)
                        {
                            <div class="small text-muted">@a.RejectionReason</div>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

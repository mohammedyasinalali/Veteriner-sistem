@using VetKlinik.Web.Infrastructure
@model IReadOnlyList<VetKlinik.Web.Domain.Appointment>

@if (Model.Count == 0)
{
    <p class="text-muted small mb-0">Kayıt yok.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="text-nowrap" style="width: 11rem">@a.StartsAt.ToString("dd.MM ddd HH:mm")</td>
                    <td><a asp-controller="Appointments" asp-action="Details" asp-route-id="@a.Id">@a.Pet.Name</a>
                        <span class="text-muted small">· @a.Pet.Owner.FullName</span></td>
                    <td>@a.Service.Name <span class="text-muted small">(@a.DurationMinutes dk)</span></td>
                    <td><partial name="~/Views/Appointments/_Actions.cshtml" model="a" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

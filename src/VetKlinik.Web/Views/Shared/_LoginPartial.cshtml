@using Microsoft.AspNetCore.Identity
@using VetKlinik.Web.Domain
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    var user = await UserManager.GetUserAsync(User);
    <li class="nav-item">
        <span class="nav-link text-dark">@(user?.FullName ?? User.Identity.Name)</span>
    </li>
    <li class="nav-item">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-link nav-link text-dark">Çıkış</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Giriş Yap</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm ms-sm-2 mt-1" asp-area="" asp-controller="Account" asp-action="Register">Üye Ol</a>
    </li>
}
</ul>

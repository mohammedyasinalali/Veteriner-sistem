@model List<VetKlinik.Web.Services.SpecialtyRow>
@{ ViewData["Title"] = "Uzmanlık Alanları"; }

<h1 class="h3 mb-3">Uzmanlık Alanları</h1>
<partial name="_AdminNav" />
<form asp-action="Create" method="post" class="row g-2 mb-4" style="max-width: 32rem">
    <div class="col">
        <input name="name" class="form-control" placeholder="Yeni uzmanlık alanı" required maxlength="100" aria-label="Uzmanlık adı" />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Ekle</button></div>
</form>
<ul class="list-group" style="max-width: 32rem">
@foreach (var s in Model)
{
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <span>@s.Name <span class="text-muted small">· @s.VeterinarianCount hekim</span></span>
        <form asp-action="Delete" asp-route-id="@s.Id" method="post">
            <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(s.VeterinarianCount > 0)"
                    title="@(s.VeterinarianCount > 0 ? "Hekimlere atanmış uzmanlık silinemez" : "Sil")">Sil</button>
        </form>
    </li>
}
</ul>

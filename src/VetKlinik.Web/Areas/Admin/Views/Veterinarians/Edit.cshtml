@model VetKlinik.Web.Models.Admin.VeterinarianFormModel
@{ ViewData["Title"] = "Hekimi Düzenle"; }

<h1 class="h3 mb-3">Hekimi Düzenle</h1>
<partial name="_AdminNav" />
<form asp-action="Edit" asp-route-id="@ViewData["Id"]" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model VetKlinik.Web.Domain.Veterinarian
@{ ViewData["Title"] = "Hekimi Sil"; }

<h1 class="h3 mb-3">Hekimi Sil</h1>
<partial name="_AdminNav" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="card shadow-sm" style="max-width: 32rem">
    <div class="card-body">
        <p><strong>@Model.Title @Model.User.FullName</strong> ve giriş hesabı silinecek. Emin misiniz?</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Sil</button>
            <a asp-action="Index" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

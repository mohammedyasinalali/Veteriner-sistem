@model List<VetKlinik.Web.Domain.Service>
@{ ViewData["Title"] = "Hizmetler"; }

<h1 class="h3 mb-3">Hizmetler</h1>
<partial name="_AdminNav" />
<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary">Yeni hizmet</a>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Hizmet</th><th>Süre</th><th class="text-end">Ücret</th><th>Durum</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@s.Name</div>
                    <div class="text-muted small">@s.Description</div>
                </td>
                <td>@s.DurationMinutes dk</td>
                <td class="text-end">@s.Price.ToString("N2") ₺</td>
                <td>
                    @if (s.IsActive) { <span class="badge text-bg-success">Aktif</span> }
                    else { <span class="badge text-bg-secondary">Pasif</span> }
                </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
